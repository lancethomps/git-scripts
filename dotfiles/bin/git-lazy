#!/usr/bin/env bash
################################################################### SETUP ########################################################################
if ! _SCRIPT_DIR="$(get_script_dir "${BASH_SOURCE[0]}")"; then echo "Error while running: _SCRIPT_DIR=\"\$(get_script_dir \"${BASH_SOURCE[0]}\")\"" && exit 1; fi
# shellcheck source=./.command_defaults.sh
source "${_SCRIPT_DIR}/.command_defaults.sh" || exit 1
set -o errexit -o errtrace -o nounset
##################################################################################################################################################

declare -x commit_message commit_files=() args_are_files="${args_are_files:-false}"

################################################################### USAGE ########################################################################
_SCRIPT_NAME="$(basename "$0")"

function _usage() {
  local SYNOP_INDENT
  SYNOP_INDENT="$(head -c "$(echo -n "${_SCRIPT_NAME}" | wc -c)" </dev/zero | tr '\0' " ")"

  cat <<EOF
NAME
       ${_SCRIPT_NAME}

SYNOPSIS
       ${_SCRIPT_NAME} [--cd-to-git-base-dir] [--files] [--select-files] [--use-files-for-message-if-missing]
       ${_SCRIPT_NAME} [--file | -f <file_to_commit>...] [--message | -m <message>] [--validate-files-less-than <validate_files_less_than>]
       ${_SCRIPT_NAME} <message_or_files>
       ${SYNOP_INDENT} [--help] [--debug] [--verbose]

EXAMPLES
       ${_SCRIPT_NAME}
EOF
}
##################################################################################################################################################

################################################################# SCRIPTARGS #####################################################################
while test $# -gt 0; do
  case "$1" in
    -h | --help)
      _usage
      exit 0
      ;;
    --debug)
      export debug_mode=true
      shift
      ;;
    --verbose)
      export verbose=true
      shift
      ;;
    --cd-to-git-base-dir)
      cd_to_git_base_dir=true
      shift
      ;;
    --files)
      args_are_files=true
      shift
      ;;
    --select-files)
      select_files=true
      shift
      ;;
    --file | -f)
      shift
      commit_files+=("$1")
      shift
      ;;
    --message | -m)
      shift
      commit_message="$1"
      args_are_files=true
      shift
      ;;
    --use-files-for-message-if-missing)
      use_files_for_message_if_missing=true
      shift
      ;;
    --validate-files-less-than)
      shift
      validate_files_less_than="$1"
      shift
      ;;
    --)
      shift
      args_are_files=true
      break
      ;;
    -*)
      echo "Unknown option: $1"
      _usage
      exit 1
      ;;
    *)
      break
      ;;
  esac
done
##################################################################################################################################################

function ask_for_commit_message() {
  commit_message="$(ask_user_for_input "Please enter a commit message")"
}

function check_validate_files_less_than() {
  local staged_files_count

  if test -z "${validate_files_less_than-}"; then
    return 0
  fi

  if ! staged_files_count="$(git diff --cached --numstat | wc -l)"; then
    exit_fatal "Could not get staged files count"
  fi

  if test "${staged_files_count}" -gt "${validate_files_less_than}"; then
    exit_fatal "The count of staged files exceeds the max specified by --validate-files-less-than: ${staged_files_count} > ${validate_files_less_than}"
  fi

  return 0
}

function main() {
  if check_true "${cd_to_git_base_dir-}"; then
    cd "$(git base-dir)"
  fi

  if check_true "${args_are_files-}"; then
    commit_files+=("$@")
    shift "$#"
  fi

  if check_true "${select_files-}"; then
    mapfile -t -O "${#commit_files[@]}" commit_files < <(git ls-files --others --exclude-standard --modified | fzf --ansi --multi --no-sort --layout "reverse" --header "Select files to commit")
  fi

  if test -n "${1-}"; then
    commit_message="${commit_message-}$*"
  fi

  if test -z "${commit_message-}"; then
    if test "${use_files_for_message_if_missing-}" = "true"; then
      if test "${#commit_files[@]}" -eq 0; then
        echo "No files for commit message"
        ask_for_commit_message
      else
        commit_message="Update files: $(join_by ' ' "${commit_files[@]}")"
      fi
    else
      ask_for_commit_message
    fi
  fi

  if test "${#commit_files[@]}" -eq 0; then
    commit_files+=(--all)
  fi

  if check_debug; then
    echo "commit_files: ${commit_files[*]}"
    echo "commit_message: ${commit_message}"
    if ! confirm "Commit and push?"; then
      exit 0
    fi
  fi

  git add "${commit_files[@]}"
  check_validate_files_less_than
  git commit -m "$commit_message"
  git push-allow-no-remote
}

main "$@"
